# ====================================================================
# HsCreations Sydney NSW Employee Management System (EMS)
# Production cPanel Environment Configuration Template
# ====================================================================

# --------------------------------------------------------------------
# 1. MySQL Database Configuration (cPanel MySQL Database Wizard)
# --------------------------------------------------------------------
# DB_HOST: Usually 'localhost' on cPanel / CloudLinux. If remote, provide server IP or hostname.
DB_HOST=localhost
DB_PORT=3306

# DB_USER: Your cPanel MySQL username (e.g., cpaneluser_emsadmin)
DB_USER=cpaneluser_emsadmin

# DB_PASSWORD: The strong password created for your database user
DB_PASSWORD=YourStrongDatabasePassword123!

# DB_NAME: Your cPanel database name (e.g., cpaneluser_emsdb)
DB_NAME=cpaneluser_emsdb

# --------------------------------------------------------------------
# 2. Application Base URL
# --------------------------------------------------------------------
# Set this to your live custom domain or subdomain
NEXT_PUBLIC_APP_URL=https://ems.hscreations.com.au

# --------------------------------------------------------------------
# 3. SMTP Transactional Email Dispatch (cPanel Webmail / SendGrid)
# --------------------------------------------------------------------
# Required for OTP verification codes and instant leave notifications
SMTP_HOST=mail.hscreations.com.au
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notifications@hscreations.com.au
SMTP_PASSWORD=YourEmailPassword123!
SMTP_FROM="HsCreations EMS" <notifications@hscreations.com.au>
ADMIN_NOTIFICATION_EMAIL=admin@hscreations.com.au

# --------------------------------------------------------------------
# 4. Node Environment & Port Configuration
# --------------------------------------------------------------------
NODE_ENV=production
PORT=3000
