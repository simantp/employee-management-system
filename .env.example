# ====================================================================
# HsCreations EMS - Environment Configuration (.env)
# ====================================================================

# 1. Node Environment & Port
NODE_ENV=production
PORT=3000

# 2. cPanel MySQL Database Credentials
# (Found in cPanel -> MySQL Databases / phpMyAdmin)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_ems_database
DB_USER=cpaneluser_ems_user
DB_PASSWORD=your_strong_mysql_password_here

# 3. Email / SMTP Configuration (Optional - for staff invites & alerts)
# Use your cPanel Webmail SMTP details (cPanel -> Email Accounts)
SMTP_HOST=mail.yourdomain.com.au
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@yourdomain.com.au
SMTP_PASSWORD=your_email_password
SMTP_FROM_NAME="HsCreations HR & Compliance"
SMTP_FROM_EMAIL=noreply@yourdomain.com.au

# 4. App Base URL
NEXT_PUBLIC_APP_URL=https://portal.yourdomain.com.au
